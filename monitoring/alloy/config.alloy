// Grafana Alloy — Versand von Metriken und Logs an Grafana Cloud (Free-Tier, EU-Region).
//
// Tokens/URLs kommen ausschliesslich aus Umgebungsvariablen (siehe .env.example), nie aus dem Repo.
// Alloy laeuft als Sidecar im docker-compose-Netz und erreicht die App unter dem Service-Namen "app".

// --- Metriken: /actuator/prometheus scrapen und per remote_write an Grafana Cloud ---
prometheus.scrape "locodoko" {
  targets = [{
    __address__ = "app:8081",
    job         = "locodoko",
  }]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_PROM_URL")
    basic_auth {
      username = sys.env("GRAFANA_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

// --- Logs: strukturierte JSON-Datei (ECS) der App nach Loki ---
// Die App schreibt nach /app/logs/locodoko.log; das geteilte Volume "applogs" wird hier als /logs gemountet.
local.file_match "locodoko_logs" {
  path_targets = [{
    __path__ = "/logs/locodoko.log",
    job      = "locodoko",
  }]
}

loki.source.file "locodoko" {
  targets    = local.file_match.locodoko_logs.targets
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_LOKI_URL")
    basic_auth {
      username = sys.env("GRAFANA_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}
