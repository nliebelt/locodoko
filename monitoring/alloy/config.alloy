// Grafana Alloy — plain-Linux (systemd) auf prod1.
// Versand von Metriken + Logs an Grafana Cloud (Free-Tier, EU-Region).
//
// Deployment: DECISION-DEPLOY-VARIANTE (S152) = plain Linux + Java, kein Docker.
// Alloy läuft als systemd-Service (nicht als docker-compose-Sidecar) und wird nach
// /etc/alloy/config.alloy deployed. Tokens/URLs kommen ausschliesslich aus
// /etc/default/alloy (EnvironmentFile, chmod 600), nie im Klartext hier.

logging {
  level  = "warn"
  format = "logfmt"
}

// === Host-Metriken (Node Exporter) — u.a. node_reboot_required, node_boot_time_seconds ===
prometheus.exporter.unix "host" {
  include_exporter_metrics = true
  disable_collectors       = ["mdadm"]
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// === App-Metriken: Spring Boot Actuator (intern, Port 8082 — nicht 8081, das ist die App) ===
prometheus.scrape "locodoko" {
  targets = [{
    __address__ = "localhost:8082",
    job         = "locodoko",
  }]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_PROM_URL")
    basic_auth {
      username = sys.env("GRAFANA_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

// === Logs: strukturierte JSON-Datei (ECS) der App nach Loki ===
local.file_match "locodoko" {
  path_targets = [{
    __path__ = "/opt/locodoko/logs/locodoko.log",
    job      = "locodoko",
    host     = constants.hostname,
  }]
}

loki.source.file "locodoko" {
  targets    = local.file_match.locodoko.targets
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_LOKI_URL")
    basic_auth {
      username = sys.env("GRAFANA_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}
