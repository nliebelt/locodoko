# =============================================================================
# Locodoko — Umgebungsvariablen
# =============================================================================
# Kopiere diese Datei nach .env und fülle die Werte aus.
# Die .env-Datei enthält Secrets und darf NICHT ins Git-Repo.

# --- Entwicklungsumgebung (Agent-Container) ---
# GitHub token for gh CLI — required for gh auth and Copilot CLI extension.
# Create a fine-grained personal access token at:
# https://github.com/settings/personal-access-tokens
# Minimum required scopes: repo, read:user
GH_TOKEN=your_github_token_here

# =============================================================================
# Produktionsbetrieb (docker compose --profile prod)
# =============================================================================

# --- Datenbank ---
LOCODOKO_DB_USERNAME=locodoko
LOCODOKO_DB_PASSWORD=sicheres-passwort-hier-einsetzen
# LOCODOKO_DB_URL=jdbc:postgresql://postgres:5432/locodoko  # default (docker-compose interne Adresse)

# --- Google OAuth2 (optional — ohne diese Variablen wird kein Google-Button angezeigt) ---
# Credentials anlegen unter: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<deine-domain>/login/oauth2/code/google
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled

# --- WebSocket / CORS (auf die eigene Domain setzen) ---
LOCODOKO_WEBSOCKET_ALLOWED_ORIGINS=https://zock.locodoko.de

# --- Session-Timeout (optional, default: 60m) ---
# LOCODOKO_SESSION_TIMEOUT=60m

# --- Backup-Rotation (optional, default: 7 Tage) ---
# BACKUP_RETENTION_TAGE=7

# --- Sentry Fehlererfassung (optional — ohne DSN deaktiviert) ---
# Free-Tier EU-Region + AVV. Session-Replay bewusst AUS (Datenschutz).
# Backend: zur Laufzeit gelesen. Frontend: VITE_SENTRY_DSN muss zur BUILD-Zeit gesetzt sein
# (sonst wird Sentry per Tree-Shaking aus dem Bundle entfernt).
# SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project>
# SENTRY_ENVIRONMENT=produktion
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project>
# VITE_SENTRY_ENVIRONMENT=produktion

# --- In-App Bugreport (optional — ohne Token/Repo: nur Logging, kein GitHub-Issue) ---
# Privates Bugreport-Repo anlegen (z.B. locodoko-bugreport), GitHub-Token mit issues:write.
# Loki-URL für Deep-Links in den Bugreport-Issues (optional).
# LOCODOKO_BUGREPORT_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# LOCODOKO_BUGREPORT_GITHUB_REPO=<owner>/locodoko-bugreport
# LOCODOKO_BUGREPORT_LOKI_BASE_URL=https://locodoko.grafana.net

# --- Grafana Cloud (Monitoring + Logs via Alloy-Sidecar, optional) ---
# Werte aus Grafana Cloud > Connections (EU-Region). Der Token deckt Metrics + Logs ab.
# GRAFANA_PROM_URL=https://prometheus-prod-XX-eu-west-2.grafana.net/api/prom/push
# GRAFANA_PROM_USER=123456
# GRAFANA_LOKI_URL=https://logs-prod-eu-west-0.grafana.net/loki/api/v1/push
# GRAFANA_LOKI_USER=123456
# GRAFANA_CLOUD_TOKEN=glc_xxxxxxxxxxxxxxxxxxxx
